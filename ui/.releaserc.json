{
  "tagFormat": "ui-v${version}",
  "branches": ["main"],
  "plugins": [
    [
      "../scripts/release-filter-scopes.js",
      { "include": ["ui"] }
    ],
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits",
        "releaseRules": [
          { "type": "perf", "release": "patch" },
          { "type": "refactor", "release": "patch" },
          { "type": "revert", "release": "patch" },
          { "type": "docs", "release": false },
          { "type": "test", "release": false },
          { "type": "build", "release": false },
          { "type": "ci", "release": false },
          { "type": "chore", "release": false }
        ]
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits",
        "presetConfig": {
          "types": [
            { "type": "feat", "section": "Features" },
            { "type": "fix", "section": "Bug Fixes" },
            { "type": "perf", "section": "Performance" },
            { "type": "refactor", "section": "Refactoring" },
            { "type": "revert", "section": "Reverts" },
            { "type": "docs", "section": "Documentation", "hidden": true },
            { "type": "test", "section": "Tests", "hidden": true },
            { "type": "build", "section": "Build", "hidden": true },
            { "type": "ci", "section": "CI", "hidden": true },
            { "type": "chore", "section": "Chores", "hidden": true }
          ]
        }
      }
    ],
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md",
        "changelogTitle": "# Changelog\n\nAll notable changes to **@alacris/ui** are documented here. Releases are cut\nindependently of the Alacris library by semantic-release, from Conventional\nCommits scoped `ui` (or the legacy `starter`)."
      }
    ],
    "@semantic-release/npm",
    [
      "@semantic-release/exec",
      {
        "//": "Rewrite @alacris/ui CDN pins in the docs. Pass --ui so a UI version cannot retarget @alacris/core. --stage is what gets them into the release commit: this runs with cwd=ui, and @semantic-release/git finds candidates with git ls-files from there, so it never sees the ../ assets below.",
        "prepareCmd": "node ../scripts/sync-docs.mjs --ui ${nextRelease.version} --stage"
      }
    ],
    [
      "@semantic-release/github",
      {
        "successCommentCondition": false,
        "failCommentCondition": false,
        "releaseNameTemplate": "@alacris/ui ${nextRelease.version}"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "package.json",
          "CHANGELOG.md",
          "README.md",
          "../README.md",
          "../starter/README.md",
          "../docs/public/AGENTS.md",
          "../docs/src/content/docs/**/*.md",
          "../docs/src/content/docs/**/*.mdx",
          "../docs/src/lib/stackblitz.ts",
          "../demo/index.html"
        ],
        "message": "chore(ui-release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ]
  ]
}
